{
  "manifest_version": 3,
  "name": "Deepseek RTL Extension",
  "version": "1.1.0",
  "description": "Toggle right-to-left layout for DeepSeek",
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"]
}
